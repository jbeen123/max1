# Production Environment Variables for Vercel
# Copy these to your Vercel dashboard: Project Settings → Environment Variables

# Database (Required)
DATABASE_URL=postgresql://username:password@host:5432/market_ai

# Authentication (Required)
NEXTAUTH_SECRET=your-random-secret-here-generate-with-openssl
NEXTAUTH_URL=https://your-domain.vercel.app

# App Info
NEXT_PUBLIC_APP_NAME="market.ai"
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Optional: Email (Resend)
# RESEND_API_KEY=re_your_key_here
# INVITE_EMAIL_FROM="Market AI <no-reply@market.ai>"

# Optional: Image Uploads (AWS S3)
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_REGION=us-east-1

# Optional: Monitoring
# SENTRY_DSN=your-sentry-dsn
