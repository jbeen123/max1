generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  UNDER_CONTRACT
  ASSIGNED
  CLOSED
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum KycProvider {
  PERSONA
  STRIPE_IDENTITY
  SUMSUB
}

enum KycStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum ESignProvider {
  DOCUSIGN
  DROPBOX_SIGN
}

enum EnvelopeStatus {
  SENT
  COMPLETED
  DECLINED
  VOIDED
}

enum TransactionStatus {
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  role          Role
  state         String?
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  properties    Property[]    @relation("SellerProperties")
  offers        Offer[]       @relation("BuyerOffers")
  kycSessions   KycSession[]
  payoutAccount PayoutAccount?
  payouts       Payout[]
  invitesSent   InviteToken[] @relation("InvitesSent")
}

model Property {
  id                 String            @id @default(cuid())
  sellerId           String
  title              String
  description        String
  state              String
  county             String
  parcelId           String?
  zoning             String?
  lotSizeAcres       Float?
  askingPrice        Int
  assignmentAllowed  Boolean           @default(false)
  disclosures        Json?
  moderationNotes    String?
  status             ListingStatus     @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  seller             User              @relation("SellerProperties", fields: [sellerId], references: [id])
  offers             Offer[]
  envelopes          ESignEnvelope[]
  transactions       DealTransaction[]
  payouts            Payout[]
}

model Offer {
  id             String      @id @default(cuid())
  propertyId     String
  buyerId        String
  amount         Int
  message        String?
  status         OfferStatus @default(SUBMITTED)
  counterAmount  Int?
  counterMessage String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id])
  buyer          User        @relation("BuyerOffers", fields: [buyerId], references: [id])
}

model KycSession {
  id             String      @id @default(cuid())
  userId         String
  provider       KycProvider
  externalId     String      @unique
  status         KycStatus   @default(PENDING_REVIEW)
  rawPayload     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id])
}

model ESignEnvelope {
  id             String         @id @default(cuid())
  propertyId     String
  provider       ESignProvider
  externalId     String         @unique
  buyerEmail     String
  sellerEmail    String
  status         EnvelopeStatus @default(SENT)
  signingUrl     String?
  rawPayload     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property       Property       @relation(fields: [propertyId], references: [id])
}

model DealTransaction {
  id               String            @id @default(cuid())
  propertyId       String
  stripeIntentId   String            @unique
  amount           Int
  currency         String            @default("usd")
  status           TransactionStatus @default(REQUIRES_PAYMENT_METHOD)
  clientSecret     String?
  rawPayload       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id])
}

model PayoutAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  stripeAccountId    String   @unique
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  detailsSubmitted   Boolean  @default(false)
  rawPayload         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model Payout {
  id                String       @id @default(cuid())
  propertyId        String
  userId            String
  stripePayoutId    String?      @unique
  amount            Int
  currency          String       @default("usd")
  status            PayoutStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  property          Property     @relation(fields: [propertyId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  source         String
  eventKey       String
  eventType      String?
  payload        Json?
  processedAt    DateTime @default(now())

  @@unique([source, eventKey])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())
}

model InviteToken {
  id            String   @id @default(cuid())
  token         String   @unique
  email         String
  role          Role
  createdById   String?
  consumedById  String?
  consumedAt    DateTime?
  revokedAt     DateTime?
  revokedById   String?
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  createdBy     User?    @relation("InvitesSent", fields: [createdById], references: [id])
}
