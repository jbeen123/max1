generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  UNDER_CONTRACT
  ASSIGNED
  CLOSED
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String?
  role         Role
  state        String?
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  properties   Property[]  @relation("SellerProperties")
  offers       Offer[]     @relation("BuyerOffers")
}

model Property {
  id                 String        @id @default(cuid())
  sellerId           String
  title              String
  description        String
  state              String
  county             String
  parcelId           String?
  zoning             String?
  lotSizeAcres       Float?
  askingPrice        Int
  assignmentAllowed  Boolean       @default(false)
  disclosures        Json?
  moderationNotes    String?
  status             ListingStatus @default(DRAFT)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  seller             User          @relation("SellerProperties", fields: [sellerId], references: [id])
  offers             Offer[]
}

model Offer {
  id             String      @id @default(cuid())
  propertyId     String
  buyerId        String
  amount         Int
  message        String?
  status         OfferStatus @default(SUBMITTED)
  counterAmount  Int?
  counterMessage String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id])
  buyer          User        @relation("BuyerOffers", fields: [buyerId], references: [id])
}
