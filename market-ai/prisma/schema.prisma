generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  UNDER_CONTRACT
  ASSIGNED
  CLOSED
}

enum OfferStatus {
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum KycProvider {
  PERSONA
  STRIPE_IDENTITY
  SUMSUB
}

enum KycStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum ESignProvider {
  DOCUSIGN
  DROPBOX_SIGN
}

enum EnvelopeStatus {
  SENT
  COMPLETED
  DECLINED
  VOIDED
}

enum TransactionStatus {
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum PayoutStatus {
  PENDING
  IN_TRANSIT
  PAID
  FAILED
  CANCELED
}

enum UploadJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum PolicyApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  role          Role
  state         String?
  phone         String?
  company       String?
  bio           String?
  avatarUrl     String?
  isVerified    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  properties    Property[]    @relation("SellerProperties")
  offers        Offer[]       @relation("BuyerOffers")
  kycSessions   KycSession[]
  payoutAccount PayoutAccount?
  payouts       Payout[]
  invitesSent   InviteToken[] @relation("InvitesSent")
  matchScores   MatchScore[]  @relation("BuyerMatches")
}

model Property {
  id                 String            @id @default(cuid())
  sellerId           String
  title              String
  description        String
  state              String
  county             String
  parcelId           String?
  zoning             String?
  lotSizeAcres       Float?
  askingPrice        Int
  assignmentAllowed  Boolean           @default(false)
  images             Json?
  coverImage         String?
  disclosures        Json?
  moderationNotes    String?
  status             ListingStatus     @default(DRAFT)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  seller             User              @relation("SellerProperties", fields: [sellerId], references: [id])
  offers             Offer[]
  envelopes          ESignEnvelope[]
  transactions       DealTransaction[]
  payouts            Payout[]
  matchScores        MatchScore[]
  leadScore          LeadScore?
}

model Offer {
  id             String      @id @default(cuid())
  propertyId     String
  buyerId        String
  amount         Int
  message        String?
  status         OfferStatus @default(SUBMITTED)
  counterAmount  Int?
  counterMessage String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property       Property    @relation(fields: [propertyId], references: [id])
  buyer          User        @relation("BuyerOffers", fields: [buyerId], references: [id])
}

model KycSession {
  id             String      @id @default(cuid())
  userId         String
  provider       KycProvider
  externalId     String      @unique
  status         KycStatus   @default(PENDING_REVIEW)
  rawPayload     Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id])
}

model ESignEnvelope {
  id             String         @id @default(cuid())
  propertyId     String
  provider       ESignProvider
  externalId     String         @unique
  buyerEmail     String
  sellerEmail    String
  status         EnvelopeStatus @default(SENT)
  signingUrl     String?
  rawPayload     Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  property       Property       @relation(fields: [propertyId], references: [id])
}

model DealTransaction {
  id               String            @id @default(cuid())
  propertyId       String
  stripeIntentId   String            @unique
  amount           Int
  currency         String            @default("usd")
  status           TransactionStatus @default(REQUIRES_PAYMENT_METHOD)
  clientSecret     String?
  rawPayload       Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  property         Property          @relation(fields: [propertyId], references: [id])
}

model PayoutAccount {
  id                 String   @id @default(cuid())
  userId             String   @unique
  stripeAccountId    String   @unique
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  detailsSubmitted   Boolean  @default(false)
  rawPayload         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id])
}

model Payout {
  id                String       @id @default(cuid())
  propertyId        String
  userId            String
  stripePayoutId    String?      @unique
  amount            Int
  currency          String       @default("usd")
  status            PayoutStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  property          Property     @relation(fields: [propertyId], references: [id])
  user              User         @relation(fields: [userId], references: [id])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  source         String
  eventKey       String
  eventType      String?
  payload        Json?
  processedAt    DateTime @default(now())

  @@unique([source, eventKey])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  prevHash       String?
  hash           String?
  createdAt      DateTime @default(now())
}

model InviteToken {
  id            String   @id @default(cuid())
  token         String   @unique
  email         String
  role          Role
  createdById   String?
  consumedById  String?
  consumedAt    DateTime?
  revokedAt     DateTime?
  revokedById   String?
  lastSentAt    DateTime?
  resendCount   Int      @default(0)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  createdBy     User?    @relation("InvitesSent", fields: [createdById], references: [id])
}

model RateLimitEvent {
  id            String   @id @default(cuid())
  scope         String
  key           String
  createdAt     DateTime @default(now())

  @@index([scope, key, createdAt])
}

model InviteNonceUse {
  id            String   @id @default(cuid())
  nonceKey      String   @unique
  createdAt     DateTime @default(now())
}

model AuditAttestation {
  id            String   @id @default(cuid())
  tipHash       String
  logCount      Int
  storagePath   String?
  createdAt     DateTime @default(now())
}

model OpsLock {
  key           String   @id
  lockedUntil   DateTime
  owner         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UploadJob {
  id            String          @id @default(cuid())
  kind          String
  payload       Json?
  status        UploadJobStatus @default(PENDING)
  attempts      Int             @default(0)
  maxAttempts   Int             @default(5)
  runAfter      DateTime        @default(now())
  lastError     String?
  errorCategory String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model QueueCircuitState {
  queueKey        String   @id
  isOpen          Boolean  @default(false)
  openedAt        DateTime?
  openUntil       DateTime?
  failCountWindow Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model QueueCircuitEvent {
  id         String   @id @default(cuid())
  queueKey   String
  eventType  String
  reason     String?
  createdAt  DateTime @default(now())

  @@index([queueKey, createdAt])
}

model QueuePolicy {
  queueKey       String   @id
  failThreshold  Int      @default(5)
  openMs         Int      @default(300000)
  alertWebhook   String?
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model QueuePolicyApproval {
  id             String               @id @default(cuid())
  queueKey       String
  requestedById  String?
  approvedById   String?
  status         PolicyApprovalStatus @default(PENDING)
  requestPayload Json
  note           String?
  requiredVotes  Int                  @default(2)
  createdAt      DateTime             @default(now())
  expiresAt      DateTime?
  decidedAt      DateTime?

  votes          QueuePolicyApprovalVote[]

  @@index([status, expiresAt])
}

model QueuePolicyApprovalVote {
  id           String   @id @default(cuid())
  approvalId   String
  voterId      String
  createdAt    DateTime @default(now())

  approval     QueuePolicyApproval @relation(fields: [approvalId], references: [id])

  @@unique([approvalId, voterId])
}

model WebhookNonceUse {
  id         String   @id @default(cuid())
  scope      String
  nonce      String
  createdAt  DateTime @default(now())

  @@unique([scope, nonce])
}

// ── AI Matching Engine ────────────────────────────────────────────────────────

model MatchScore {
  id         String   @id @default(cuid())
  propertyId String
  buyerId    String
  score      Float
  factors    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id])
  buyer      User     @relation("BuyerMatches", fields: [buyerId], references: [id])

  @@unique([propertyId, buyerId])
}

model LeadScore {
  id         String   @id @default(cuid())
  propertyId String   @unique
  score      Float
  signals    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id])
}

// ── Contract Templates ────────────────────────────────────────────────────────

enum ContractType {
  PURCHASE_AGREEMENT
  ASSIGNMENT_CONTRACT
  OPTION_CONTRACT
}

enum ContractStatus {
  DRAFT
  PENDING_REVIEW
  SIGNED
  VOIDED
}

model ContractTemplate {
  id        String         @id @default(cuid())
  name      String
  type      ContractType
  state     String?
  content   String
  clauses   Json
  version   String         @default("1.0")
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  contracts GeneratedContract[]
}

model GeneratedContract {
  id           String          @id @default(cuid())
  templateId   String
  propertyId   String?
  buyerId      String?
  sellerId     String?
  variables    Json
  finalContent String
  status       ContractStatus  @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  template     ContractTemplate @relation(fields: [templateId], references: [id])
}

// ── Notifications + Messaging (Phase 23) ──────────────────────────────────

enum NotificationType {
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_COUNTERED
  LISTING_APPROVED
  LISTING_REJECTED
  KYC_VERIFIED
  KYC_REJECTED
  CONTRACT_READY
  CONTRACT_SIGNED
  PAYMENT_RECEIVED
  PAYMENT_SENT
  POLICY_APPROVAL_NEEDED
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  link       String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

model Conversation {
  id          String    @id @default(cuid())
  propertyId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id              String       @id @default(cuid())
  conversationId  String
  userId          String
  joinedAt        DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  body            String
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ── Policy Teams (Phase 22) ───────────────────────────────────────────────

enum PolicyTeamRole {
  REQUESTER
  APPROVER
}

model PolicyTeam {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  role      PolicyTeamRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members   PolicyTeamMember[]
}

model PolicyTeamMember {
  id        String     @id @default(cuid())
  teamId    String
  email     String?
  domain    String?
  createdAt DateTime   @default(now())

  team      PolicyTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@unique([teamId, domain])
  @@index([teamId])
}

// ── Webhook Signing Keys (Phase 22) ───────────────────────────────────────

model WebhookSigningKey {
  kid       String   @id
  secret    String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

// ── Public Records ────────────────────────────────────────────────────────────

model PublicRecord {
  id                 String   @id @default(cuid())
  parcelId           String   @unique
  ownerName          String
  ownerMailingAddress String
  propertyAddress    String
  state              String
  county             String
  assessedValue      Int
  marketValue        Int
  taxStatus          String
  zoning             String
  lotSizeAcres       Float
  improvements       Json
  deedHistory        Json
  liens              Json
  ownershipDuration  Int
  isOutOfState       Boolean  @default(false)
  lastSaleDate       DateTime?
  lastSalePrice      Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
